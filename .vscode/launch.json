{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "args": ["reducedVocabulary.json"],
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}\\fluent-backend\\importVocabulary.js"
    },
    {
      "name": "Debug Fluent Backend (with nodemon)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/fluent-backend/node_modules/nodemon/bin/nodemon.js",
      "args": ["index.js", "--no-redis"],
      "cwd": "${workspaceFolder}/fluent-backend",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "restart": false,
      "runtimeExecutable": "node",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
